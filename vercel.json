  "rewrites": [
    {
      "source": "/produit/:original_id/:slug",
      "destination": "/product?original_id=:original_id"
    },
    {
      "source": "/produit/id/:id/:slug",
      "destination": "/product?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
